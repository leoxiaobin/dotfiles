#!/bin/bash
# Generated by bin/theme-set from theme/colors.toml. Do not edit by hand.
#
# JankyBorders runs this file when it is started with no arguments, which is
# how AeroSpace's after-startup-command launches it. Before this file existed
# the options were only ever passed by hand, so they were lost on every
# reboot.
#
# style=square matches Ghostty's window-decoration = none. Rounded borders
# around square windows leave a visible notch at each corner.

options=(
	style=square
	active_color=0xff295f8a
	inactive_color=0xffddd4bf
	width=5.0
)

borders "${options[@]}"
