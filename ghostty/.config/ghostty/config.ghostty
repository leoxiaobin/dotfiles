# Shared Ghostty baseline for this dotfiles repo.
# 素 (Su) · 中国风浅色开发主题 —— 宣纸底、水墨字、传统色
background = F3EEE1
foreground = 38342C
cursor-color = 8C1234
selection-background = D6CBAE
selection-foreground = 38342C
# 16色 ANSI（素调色板）
palette = 0=5A5447
palette = 1=8C1234
palette = 2=3F6428
palette = 3=6A5D12
palette = 4=295F8A
palette = 5=5A4685
palette = 6=236B5C
palette = 7=5F584C
palette = 8=5F584C
palette = 9=8C1234
palette = 10=3F6428
palette = 11=6A5D12
palette = 12=295F8A
palette = 13=5A4685
palette = 14=236B5C
palette = 15=38342C
window-theme = system

# Maple Mono NF CN includes Latin, Chinese, and Nerd Font glyphs.
font-family = Maple Mono NF CN
font-size = 16

# Allow programs to read/write system clipboard via OSC 52
clipboard-read = allow
clipboard-write = allow

# Ghostty's default TERM is xterm-ghostty, which most remote hosts and container
# images do not carry in their terminfo database. With no entry, tput and clear
# fail, tmux refuses to start, and every arrow/Home/End/Delete key resolves to an
# empty capability. ssh-terminfo installs the entry on first connect and caches
# the result; ssh-env is the fallback that downgrades TERM to xterm-256color when
# that install is not possible. This key patches the default feature list instead
# of replacing it, so cursor/title/path stay enabled.
shell-integration-features = ssh-env,ssh-terminfo
