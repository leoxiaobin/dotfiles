# Shared Ghostty baseline for this dotfiles repo.
# 素 (Su) · 中国风浅色开发主题 —— 宣纸底、水墨字、传统色
background = F3EEE1
foreground = 38342C
cursor-color = B3433A
selection-background = D6CBAE
selection-foreground = 38342C
# 16色 ANSI（素调色板）
palette = 0=5A5447
palette = 1=B3433A
palette = 2=5D7A39
palette = 3=9C6A26
palette = 4=356A8D
palette = 5=66518C
palette = 6=3A7B71
palette = 7=C9C0AB
palette = 8=97907F
palette = 9=C2554B
palette = 10=6D8A47
palette = 11=AB7830
palette = 12=43789C
palette = 13=765F9C
palette = 14=498A80
palette = 15=38342C
window-theme = system
font-family = BlexMono Nerd Font Mono
font-size = 16

# Allow programs to read/write system clipboard via OSC 52
clipboard-read = allow
clipboard-write = allow
