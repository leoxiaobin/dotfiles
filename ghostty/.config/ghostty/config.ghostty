# Shared Ghostty baseline for this dotfiles repo.
# 素 (Su) · 中国风浅色开发主题 —— 宣纸底、水墨字、传统色
background = F3EEE1
foreground = 38342C
cursor-color = 8C1234
selection-background = D6CBAE
selection-foreground = 38342C
# 16色 ANSI（素调色板）
palette = 0=5A5447
palette = 1=8C1234
palette = 2=3F6428
palette = 3=6A5D12
palette = 4=295F8A
palette = 5=5A4685
palette = 6=236B5C
palette = 7=5F584C
palette = 8=5F584C
palette = 9=8C1234
palette = 10=3F6428
palette = 11=6A5D12
palette = 12=295F8A
palette = 13=5A4685
palette = 14=236B5C
palette = 15=38342C
window-theme = system

# Font stack:
# - BlexMono keeps Latin/code/nerd icons aligned in terminal UIs.
# - Songti SC gives Chinese text a restrained Song/Ming style that matches Su's
#   scholarly, paper-and-ink direction better than the default sans fallback.
font-family = BlexMono Nerd Font Mono
font-family = Songti SC
font-size = 16

# Allow programs to read/write system clipboard via OSC 52
clipboard-read = allow
clipboard-write = allow
