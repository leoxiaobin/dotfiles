// Windows Terminal equivalent of the shared Su terminal style.
// Install BlexMono Nerd Font Mono first:
// https://github.com/ryanoasis/nerd-fonts/releases/latest/download/IBMPlexMono.zip
{
  "profiles": {
    "defaults": {
      "adjustIndistinguishableColors": "always",
      "colorScheme": "Su",
      "font": {
        "face": "BlexMono Nerd Font Mono",
        "size": 16
      }
    }
  },
  "schemes": [
    {
      "name": "Su",
      "background": "#F3EEE1",
      "foreground": "#38342C",
      "cursorColor": "#B3433A",
      "selectionBackground": "#D6CBAE",
      "black": "#5A5447",
      "red": "#B3433A",
      "green": "#5D7A39",
      "yellow": "#7A4A18",
      "blue": "#356A8D",
      "purple": "#66518C",
      "cyan": "#3A7B71",
      "white": "#38342C",
      "brightBlack": "#6C6557",
      "brightRed": "#C2554B",
      "brightGreen": "#6D8A47",
      "brightYellow": "#8A531C",
      "brightBlue": "#43789C",
      "brightPurple": "#765F9C",
      "brightCyan": "#498A80",
      "brightWhite": "#38342C"
    }
  ]
}
