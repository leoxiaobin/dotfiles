// Windows Terminal equivalent of the shared Su terminal style.
// Install BlexMono Nerd Font Mono first:
// https://github.com/ryanoasis/nerd-fonts/releases/latest/download/IBMPlexMono.zip
{
  "profiles": {
    "defaults": {
      "adjustIndistinguishableColors": "always",
      "colorScheme": "Su",
      "font": {
        "face": "BlexMono Nerd Font Mono",
        "size": 16
      }
    }
  },
  "schemes": [
    {
      "name": "Su",
      "background": "#F3EEE1",
      "foreground": "#38342C",
      "cursorColor": "#8c1234",
      "selectionBackground": "#D6CBAE",
      "black": "#5A5447",
      "red": "#8c1234",
      "green": "#3f6428",
      "yellow": "#6a5d12",
      "blue": "#295f8a",
      "purple": "#5a4685",
      "cyan": "#236b5c",
      "white": "#38342C",
      "brightBlack": "#5f584c",
      "brightRed": "#8c1234",
      "brightGreen": "#3f6428",
      "brightYellow": "#6a5d12",
      "brightBlue": "#295f8a",
      "brightPurple": "#5a4685",
      "brightCyan": "#236b5c",
      "brightWhite": "#38342C"
    }
  ]
}
