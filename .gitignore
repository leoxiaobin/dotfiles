# Dependencies (managed by package managers / TPM / Doom)
.tmux/plugins/

# Neovim (managed by lazy.nvim)
.config/nvim/lazy-lock.json
/nvim.log

# Local overrides (machine-specific, contain secrets)
.zshrc.local
.gitconfig.local

# OS files
.DS_Store
Thumbs.db

# Rime: only declarative patches belong in this Stow package.
/rime/Library/Rime/*
!/rime/Library/Rime/*.custom.yaml
