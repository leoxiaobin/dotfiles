[core]
	editor = nvim
	pager = delta

# Machine-specific config (user identity, credential helpers, etc.)
# Keep account-specific GitHub identities out of the shared dotfiles repo.
[include]
	path = ~/.gitconfig.local
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	side-by-side = true
	line-numbers = true
	syntax-theme = GitHub
	dark = false
	zero-style = syntax
	# 素 (Su) 主题 —— 宣纸底差异色彩
	minus-style = syntax "#f0e4d1"      # 删除行淡背景
	plus-style = syntax "#e8edd6"       # 添加行淡背景
	minus-emph-style = syntax "#e1d1b8" # 删除强调
	plus-emph-style = syntax "#dce5c5"  # 添加强调
	line-numbers-left-style = "#97907f" # 墨痕
	line-numbers-right-style = "#97907f"
	line-numbers-minus-style = "#b3433a" # 朱砂（删除）
	line-numbers-plus-style = "#5d7a39"  # 竹青（添加）
	file-style = bold "#38342c"         # 墨（文件名）
	hunk-header-style = file line-number syntax "#e9e1cf"
	hyperlinks = true
[diff]
	algorithm = histogram
[merge]
	conflictstyle = zdiff3
[pull]
	rebase = true
[push]
	autoSetupRemote = true
[rerere]
	enabled = true
[alias]
	st = status
	co = checkout
	br = branch
	cm = commit -m
	d = diff
	ds = diff --staged
	lg = log --oneline --graph --decorate --all -20
