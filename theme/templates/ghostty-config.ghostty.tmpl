# Shared Ghostty baseline for this dotfiles repo.
# Generated by bin/theme-set from theme/colors.toml. Do not edit by hand.
# 素 (Su) · 中国风浅色开发主题 —— 宣纸底、水墨字、传统色
background = {{ bg }}
foreground = {{ fg }}
cursor-color = {{ error }}
selection-background = {{ selection }}
selection-foreground = {{ fg }}
# 16色 ANSI（素调色板）
palette = 0={{ dim }}
palette = 1={{ error }}
palette = 2={{ string }}
palette = 3={{ accent }}
palette = 4={{ keyword }}
palette = 5={{ builtin }}
palette = 6={{ type }}
palette = 7={{ muted }}
palette = 8={{ muted }}
palette = 9={{ error }}
palette = 10={{ string }}
palette = 11={{ accent }}
palette = 12={{ keyword }}
palette = 13={{ builtin }}
palette = 14={{ type }}
palette = 15={{ fg }}
window-theme = system

# Maple Mono NF CN includes Latin, Chinese, and Nerd Font glyphs.
font-family = Maple Mono NF CN
font-size = 16

# Allow programs to read/write system clipboard via OSC 52
clipboard-read = allow
clipboard-write = allow

# Global Quick Terminal toggle; requires macOS Accessibility permission.
keybind = global:cmd+grave_accent=toggle_quick_terminal

# Open a new AeroSpace-managed window instead of adding a tab.
keybind = cmd+t=new_window

# Ghostty's default TERM is xterm-ghostty, which most remote hosts and container
# images do not carry in their terminfo database. With no entry, tput and clear
# fail, tmux refuses to start, and every arrow/Home/End/Delete key resolves to an
# empty capability. ssh-terminfo installs the entry on first connect and caches
# the result; ssh-env is the fallback that downgrades TERM to xterm-256color when
# that install is not possible. This key patches the default feature list instead
# of replacing it, so cursor/title/path stay enabled.
shell-integration-features = ssh-env,ssh-terminfo
