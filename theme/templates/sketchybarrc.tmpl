#!/usr/bin/env bash
# Generated by bin/theme-set from theme/colors.toml. Do not edit by hand.

set -euo pipefail

PLUGIN_DIR="$CONFIG_DIR/plugins"

BG=0xff{{ bg.raw }}
BG_SOFT=0xff{{ bg_soft.raw }}
FG=0xff{{ fg.raw }}
MUTED=0xff{{ muted.raw }}
BORDER=0xff{{ border.raw }}

sketchybar --bar \
  position=top \
  height=32 \
  color="$BG" \
  border_width=1 \
  border_color="$BORDER" \
  display=main \
  topmost=on \
  shadow=off \
  sticky=on \
  padding_left=8 \
  padding_right=8

default=(
  padding_left=4
  padding_right=4
  icon.drawing=off
  icon.color="$MUTED"
  icon.font="Maple Mono NF CN:Regular:14.0"
  icon.padding_left=6
  icon.padding_right=2
  label.color="$FG"
  label.font="Maple Mono NF CN:Regular:13.0"
  label.padding_left=7
  label.padding_right=7
)
sketchybar --default "${default[@]}"

sketchybar --add event aerospace_workspace_change
sketchybar --add event aerospace_focus_change

for sid in 1 2 3 4 5 6; do
  sketchybar --add item "workspace.$sid" left \
    --set "workspace.$sid" \
      label="$sid" \
      background.color="$BG_SOFT" \
      background.corner_radius=5 \
      background.height=24 \
      background.drawing=on \
      script="$PLUGIN_DIR/aerospace.sh" \
      click_script="aerospace workspace $sid" \
    --subscribe "workspace.$sid" aerospace_workspace_change
done

sketchybar --set workspace.4 update_freq=30

sketchybar --add item front_app center \
  --set front_app \
    label="Desktop" \
    label.color="$MUTED" \
    label.max_chars=45 \
    script="$PLUGIN_DIR/front_app.sh" \
  --subscribe front_app front_app_switched aerospace_focus_change

sketchybar --add item battery right \
  --set battery \
    icon.drawing=on \
    update_freq=120 \
    script="$PLUGIN_DIR/battery.sh" \
  --subscribe battery system_woke power_source_change

sketchybar --add item volume right \
  --set volume \
    icon.drawing=on \
    script="$PLUGIN_DIR/volume.sh" \
  --subscribe volume volume_change

sketchybar --add item bluetooth right \
  --set bluetooth \
    icon=󰂯 \
    icon.drawing=on \
    update_freq=60 \
    script="$PLUGIN_DIR/bluetooth.sh" \
  --subscribe bluetooth system_woke

sketchybar --add item clock right \
  --set clock \
    icon=󰥔 \
    icon.drawing=on \
    update_freq=10 \
    script="$PLUGIN_DIR/clock.sh"

focused_workspace="$(aerospace list-workspaces --focused 2>/dev/null || true)"
if [[ -n "$focused_workspace" ]]; then
  sketchybar --trigger aerospace_workspace_change "FOCUSED_WORKSPACE=$focused_workspace"
fi

sketchybar --update
