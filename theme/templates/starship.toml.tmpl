# Generated by bin/theme-set from theme/colors.toml. Do not edit by hand.
"$schema" = 'https://starship.rs/config-schema.json'
palette = "su"

[palettes.su]
# 素 (Su) · 传统色调色板
su_bg = "{{ bg }}"       # 宣纸
su_ink = "{{ fg }}"      # 墨
su_muted = "{{ muted }}"    # 墨痕
su_accent = "{{ accent }}"   # 缃色（function/调用）
su_red = "{{ error }}"      # 朱砂（error）
su_green = "{{ string }}"    # 竹青（string/内容）
su_yellow = "{{ number }}"   # 赭石（number）
su_blue = "{{ keyword }}"     # 青花（keyword）
su_purple = "{{ builtin }}"   # 黛紫（builtin）
su_cyan = "{{ type }}"     # 天青（type）
su_field = "{{ field }}"    # 胭脂（field）

